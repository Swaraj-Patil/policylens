# PolicyLens frontend — environment variables
#
# Vite only exposes vars prefixed with VITE_ to client code. All values here
# are safe to commit (none are secrets); the .env.example pattern just
# documents the contract.

# ---------------------------------------------------------------------------
# VITE_API_BASE_URL
# ---------------------------------------------------------------------------
# Base URL of the FastAPI backend. The frontend calls `${VITE_API_BASE_URL}/query`.
#
# Production:  REQUIRED. Must be the full deployed backend URL.
#   Example:   VITE_API_BASE_URL=https://policylens-api.example.com
#
# Development: OPTIONAL. If unset, the app falls back to "/api" and Vite's
#              dev-server proxy (vite.config.ts) forwards to localhost:8000.
#              You can still set it explicitly if you'd rather hit the
#              backend directly without the proxy:
#   Example:   VITE_API_BASE_URL=http://localhost:8000
#
# A missing value in a production build throws a hard error at app load —
# silent fallbacks are deliberately not allowed.

VITE_API_BASE_URL=
