# =============================================================
# PolicyLens — environment configuration
# Copy this file to `.env` and fill in real values.
# =============================================================

# ---- LLM provider --------------------------------------------
# Selects which backend the /query endpoint talks to.
#   ollama  → local development (default)
#   groq    → production / hosted deployments
LLM_PROVIDER=ollama

# ---- Ollama (local development) ------------------------------
# Used when LLM_PROVIDER=ollama. Run `ollama serve` in a separate terminal.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b-instruct

# ---- Groq (production) ---------------------------------------
# Used when LLM_PROVIDER=groq. Free key (no credit card) at:
#   https://console.groq.com/keys
# Free-tier quota is generous (~30 RPM on llama3-70b at time of writing —
# check the dashboard for current limits).
GROQ_API_KEY=
GROQ_MODEL=llama3-70b-8192

# ---- CORS / frontend origin ----------------------------------
# Production: full URL of the deployed frontend (e.g. https://policylens.vercel.app).
# Localhost variants are always allowed in addition to this value, so you
# can leave it blank in dev.
FRONTEND_ORIGIN=

# ---- Chunking ------------------------------------------------
CHUNK_TARGET_TOKENS=400
CHUNK_OVERLAP_TOKENS=50

# ---- Retrieval -----------------------------------------------
RETRIEVAL_TOP_K=8

# Flesch–Kincaid grade level above which a passage is flagged
# as "high reading difficulty" in answers.
HIGH_READING_DIFFICULTY_THRESHOLD=14

# ---- Storage paths (relative to backend/) --------------------
CHROMA_PERSIST_DIR=./data/chroma_db
PDF_DIR=./data/pdfs

# ---- Dev -----------------------------------------------------
# Disk cache for LLM responses — speeds up repeat queries during dev.
# Disable in production by setting to false.
LLM_CACHE_ENABLED=true
LLM_CACHE_DIR=./.llm_cache
