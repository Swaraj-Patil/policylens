# =============================================================
# PolicyLens — environment configuration
# Copy this file to `.env` and fill in real values.
# =============================================================

# ---- LLM provider ----
# Default: local Ollama. No API key required.
# Set USE_LOCAL_LLM=false to use Gemini instead.
USE_LOCAL_LLM=true
LOCAL_LLM_MODEL=qwen2.5:7b-instruct
OLLAMA_BASE_URL=http://localhost:11434

# ---- Optional: Gemini cloud fallback (used when USE_LOCAL_LLM=false) ----
# Get a free key (no credit card) at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ---- Chunking ----
CHUNK_TARGET_TOKENS=400
CHUNK_OVERLAP_TOKENS=50

# ---- Retrieval ----
RETRIEVAL_TOP_K=8

# Flesch–Kincaid grade level above which a passage is flagged
# as "high reading difficulty" in answers.
HIGH_READING_DIFFICULTY_THRESHOLD=14

# ---- Storage paths (relative to backend/) ----
CHROMA_PERSIST_DIR=./data/chroma_db
PDF_DIR=./data/pdfs

# ---- Dev ----
# Set to "true" to cache LLM responses to disk (saves time on repeat queries)
LLM_CACHE_ENABLED=true
LLM_CACHE_DIR=./.llm_cache
